<UserControl x:Class="PCHelper.Views.FixesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DockPanel>

        <Border DockPanel.Dock="Top" Margin="28,16,28,0" Style="{StaticResource Card}" Padding="16,14">
            <StackPanel>
                <TextBlock Style="{StaticResource Muted}"
                           Text="Jede Reparatur zeigt genau, welche Befehle ausgefuehrt werden. Sie laufen als Administrator - Windows fragt jeweils nach. Fast alle Aenderungen lassen sich mit einem Klick zuruecknehmen." />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <CheckBox Content="Vor der ersten Aenderung einen Wiederherstellungspunkt anlegen"
                              IsChecked="{Binding Fixes.CreateRestorePoint}" />
                    <Button Content="Jetzt einen anlegen" Style="{StaticResource GhostButton}" Margin="16,0,0,0"
                            Command="{Binding Fixes.RestorePointCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding Fixes.Status}" Style="{StaticResource Caption}" Margin="0,10,0,0" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,12,20,28">
            <ItemsControl ItemsSource="{Binding Fixes.Items}" MaxWidth="900" HorizontalAlignment="Left">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Border Style="{StaticResource Chip}" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Category}" FontSize="10.5" FontWeight="Bold" />
                                            </Border>
                                            <Border Style="{StaticResource Chip}" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding RiskText}" FontSize="10.5" />
                                            </Border>
                                            <Border Style="{StaticResource Chip}"
                                                    Visibility="{Binding NeedsReboot, Converter={StaticResource BoolVis}}">
                                                <TextBlock Text="Neustart noetig" FontSize="10.5"
                                                           Foreground="{StaticResource Warn}" />
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14.5" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" Margin="0,6,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Button Content="Anwenden" Style="{StaticResource PrimaryButton}" MinWidth="120"
                                                Command="{Binding DataContext.Fixes.ApplyCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="Zuruecknehmen" Style="{StaticResource GhostButton}" Margin="0,6,0,0"
                                                Visibility="{Binding CanRevert, Converter={StaticResource BoolVis}}"
                                                Command="{Binding DataContext.Fixes.RevertCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>

                                <Border Background="{StaticResource Surface2}" CornerRadius="8" Padding="12,10" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Warum das hilft" FontWeight="SemiBold" FontSize="12"
                                                   Foreground="{StaticResource Accent}" Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding Why}" />
                                    </StackPanel>
                                </Border>

                                <Expander Header="Diese Befehle werden ausgefuehrt">
                                    <Border Background="{StaticResource Surface2}" CornerRadius="8" Padding="12,10">
                                        <TextBox Text="{Binding CommandPreview, Mode=OneWay}" IsReadOnly="True"
                                                 BorderThickness="0" Background="Transparent" Padding="0"
                                                 FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                 TextWrapping="Wrap" />
                                    </Border>
                                </Expander>

                                <Border Background="{StaticResource Surface2}" CornerRadius="8" Padding="12,10" Margin="0,10,0,0"
                                        Visibility="{Binding HasOutput, Converter={StaticResource BoolVis}}">
                                    <StackPanel>
                                        <TextBlock Text="Ausgabe" FontWeight="SemiBold" FontSize="12"
                                                   Foreground="{StaticResource Dim}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding LastOutput, Mode=OneWay}" IsReadOnly="True"
                                                 BorderThickness="0" Background="Transparent" Padding="0"
                                                 FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                 TextWrapping="Wrap" MaxHeight="220"
                                                 VerticalScrollBarVisibility="Auto" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
