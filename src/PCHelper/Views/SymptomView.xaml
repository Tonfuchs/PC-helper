<UserControl x:Class="PCHelper.Views.SymptomView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DockPanel>

        <!-- Freitextsuche -->
        <Border DockPanel.Dock="Top" Margin="28,16,28,0" Style="{StaticResource Card}" Padding="16,14">
            <StackPanel>
                <TextBlock Text="Was macht der Rechner?"
                           FontWeight="SemiBold" FontSize="14.5" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,3,0,10" TextWrapping="Wrap"
                           Text="In eigenen Worten beschreiben - zum Beispiel: 'mein Mikrofon wird in Discord nicht erkannt', 'der Bildschirm wird schwarz', 'kein Internet', 'alles ist langsam'." />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Padding="10,8" FontSize="14"
                             Text="{Binding Symptoms.Query, UpdateSourceTrigger=PropertyChanged, Delay=150}" />

                    <Button Grid.Column="1" Content="Zuruecksetzen" Style="{StaticResource GhostButton}"
                            Margin="8,0,0,0" Command="{Binding Symptoms.ClearCommand}" />
                </Grid>

                <TextBlock Text="{Binding Symptoms.ResultHint}" Style="{StaticResource Caption}"
                           Margin="0,10,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Grid Margin="28,12,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="1.15*" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <!-- ============ Liste der Symptome ============ -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                <ItemsControl ItemsSource="{Binding Symptoms.Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,6">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource H2}" Margin="0,8,0,6" />

                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button HorizontalContentAlignment="Stretch"
                                                    Style="{StaticResource GhostButton}"
                                                    Padding="14,11" Margin="0,0,0,6"
                                                    Command="{Binding DataContext.Symptoms.SelectCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding CauseSummary}" Style="{StaticResource Caption}"
                                                               TextWrapping="Wrap" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- ============ Detail zum gewaehlten Symptom ============ -->
            <Grid Grid.Column="1">

                <!-- Platzhalter, solange nichts gewaehlt ist -->
                <Border Style="{StaticResource Card}" Padding="20,18" VerticalAlignment="Top"
                        Visibility="{Binding Symptoms.HasSelection, Converter={StaticResource InverseBoolVis}}">
                    <StackPanel>
                        <TextBlock Text="Noch nichts ausgewaehlt" FontWeight="SemiBold" FontSize="14.5" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="Links einen Fall anklicken. Danach steht hier, was typischerweise dahintersteckt, was man sofort selbst pruefen kann - und die Untersuchung laesst sich gezielt darauf ansetzen." />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"
                                   Text="Passt nichts? Dann hilft die vollstaendige Diagnose, die ohne Vorannahme alles prueft." />
                        <Button Content="Vollstaendige Diagnose starten" Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Left" Margin="0,14,0,0"
                                Command="{Binding Diagnose.RunCommand}" />
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding Symptoms.HasSelection, Converter={StaticResource BoolVis}}">
                    <StackPanel Margin="0,0,8,0">

                        <!-- Kopf -->
                        <Border Style="{StaticResource Card}" Padding="20,18">
                            <StackPanel>
                                <TextBlock Text="{Binding Symptoms.Selected.Title}" TextWrapping="Wrap"
                                           FontWeight="SemiBold" FontSize="15.5" />
                                <TextBlock Text="{Binding Symptoms.Selected.Description}" TextWrapping="Wrap"
                                           Style="{StaticResource Muted}" Margin="0,8,0,0" />

                                <Border Background="{StaticResource Surface2}" CornerRadius="8" Padding="12,10" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Kommt typischerweise von" FontWeight="SemiBold" FontSize="12"
                                                   Foreground="{StaticResource Accent}" Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding Symptoms.CauseSummary}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="{Binding Symptoms.CheckCountText}" Style="{StaticResource Caption}"
                                           Margin="0,12,0,0" TextWrapping="Wrap" />

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="Gezielte Untersuchung starten" Style="{StaticResource PrimaryButton}"
                                            Command="{Binding Symptoms.StartDiagnosisCommand}" Margin="0,0,8,0" />
                                    <Button Content="Alles pruefen" Style="{StaticResource SecondaryButton}"
                                            ToolTip="Vollstaendiger Rundumlauf ohne Vorannahme."
                                            Command="{Binding Diagnose.RunCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Sofort selbst pruefen -->
                        <Border Style="{StaticResource Card}" Padding="20,18">
                            <StackPanel>
                                <TextBlock Text="Das laesst sich sofort selbst pruefen" FontWeight="SemiBold" FontSize="14" />
                                <ItemsControl ItemsSource="{Binding Symptoms.FirstSteps}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Grid.Column="0" Width="6" Height="6" Margin="2,8,10,0"
                                                         VerticalAlignment="Top" Fill="{StaticResource Accent}" />
                                                <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Passende Werkzeuge: direkt ausfuehrbar -->
                        <Border Style="{StaticResource Card}" Padding="20,18"
                                Visibility="{Binding Symptoms.RecommendedTools.Count,
                                             Converter={StaticResource CountVis}}">
                            <StackPanel>
                                <TextBlock Text="Passende Werkzeuge" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,8"
                                           Text="Oeffnet die zustaendige Windows-Stelle direkt." />

                                <ItemsControl ItemsSource="{Binding Symptoms.RecommendedTools}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}"
                                                               TextWrapping="Wrap" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="{Binding ButtonText}" MinWidth="100"
                                                        Style="{StaticResource SecondaryButton}" VerticalAlignment="Center"
                                                        Command="{Binding Command}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Passende Reparaturen -->
                        <Border Style="{StaticResource Card}" Padding="20,18"
                                Visibility="{Binding Symptoms.RecommendedFixes.Count,
                                             Converter={StaticResource CountVis}}">
                            <StackPanel>
                                <TextBlock Text="Passende Reparaturen" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,8" TextWrapping="Wrap"
                                           Text="Jede Aenderung wird vorher im Wortlaut angezeigt und ist umkehrbar. Ausgefuehrt wird sie im Bereich 'Reparaturen'." />

                                <ItemsControl ItemsSource="{Binding Symptoms.RecommendedFixes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,10">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}"
                                                           TextWrapping="Wrap" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Content="Zu den Reparaturen" Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Left" Margin="0,4,0,0"
                                        Command="{Binding Symptoms.ShowFixesCommand}" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
