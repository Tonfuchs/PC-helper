<UserControl x:Class="PCHelper.Views.MaintenanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DockPanel>

        <!-- Bereiche, Erklaerung und Status -->
        <Border DockPanel.Dock="Top" Margin="28,16,28,0" Style="{StaticResource Card}" Padding="16,14">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Maintenance.Sections}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource TabButton}" Content="{Binding Title}"
                                         GroupName="maintenance" IsChecked="{Binding IsCurrent, Mode=OneWay}"
                                         Command="{Binding DataContext.Maintenance.SelectCommand,
                                                   RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding Maintenance.Current.Intro}" Style="{StaticResource Muted}" Margin="0,12,0,0" />

                <Border Background="{StaticResource Surface2}" CornerRadius="8" Padding="12,10" Margin="0,10,0,0"
                        Visibility="{Binding Maintenance.Current.HasNote, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding Maintenance.Current.Note}" Foreground="{StaticResource Warn}" />
                </Border>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding Maintenance.Current.Summary}" />
                        <TextBlock Text="{Binding Maintenance.Current.Status}" Margin="0,3,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding Maintenance.Current.HasStatus, Converter={StaticResource BoolVis}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Maintenance.Current.StatusIsError}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Crit}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <Button Grid.Column="1" Content="Nochmal pruefen" Style="{StaticResource PrimaryButton}"
                            Command="{Binding Maintenance.ScanCommand}"
                            CommandParameter="{Binding Maintenance.Current}" />
                </Grid>

                <ProgressBar IsIndeterminate="True" Margin="0,12,0,0"
                             Visibility="{Binding Maintenance.Current.IsBusy, Converter={StaticResource BoolVis}}" />
            </StackPanel>
        </Border>

        <!-- Punkte -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,12,20,28">
            <ItemsControl ItemsSource="{Binding Maintenance.Current.Items}" MaxWidth="900" HorizontalAlignment="Left">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="0">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsIntentional}" Value="True">
                                            <Setter Property="Opacity" Value="0.7" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Farbstreifen nach Schweregrad; eine bewusste Entscheidung gilt als in Ordnung -->
                                <Border Grid.Column="0" CornerRadius="10,0,0,10"
                                        Background="{Binding DisplaySeverity, Converter={StaticResource SeverityBrush}}" />

                                <StackPanel Grid.Column="1" Margin="16,14,16,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Style="{StaticResource Chip}" Margin="0,0,10,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding HasGroup, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="{Binding Group}" FontSize="10.5" FontWeight="Bold" />
                                        </Border>

                                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold"
                                                   FontSize="14.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                        <Border Grid.Column="2" Style="{StaticResource Chip}" Margin="10,0,0,0"
                                                VerticalAlignment="Center"
                                                Background="{Binding DisplaySeverity, Converter={StaticResource SeverityBg}}"
                                                Visibility="{Binding HasValue, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="{Binding Value}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{Binding DisplaySeverity, Converter={StaticResource SeverityBrush}}" />
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="{Binding Meaning}" Margin="0,8,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding Meaning, Converter={StaticResource NotEmpty}}" />

                                    <Border Background="{StaticResource Surface2}" CornerRadius="8" Padding="12,10" Margin="0,10,0,0"
                                            Visibility="{Binding HasRecommendation, Converter={StaticResource BoolVis}}">
                                        <StackPanel>
                                            <TextBlock Text="Was tun" FontWeight="SemiBold" FontSize="12"
                                                       Foreground="{StaticResource Accent}" Margin="0,0,0,4" />
                                            <TextBlock Text="{Binding Recommendation}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="{Binding ActionText}" Style="{StaticResource PrimaryButton}"
                                                Margin="0,0,8,0" MinWidth="120"
                                                Visibility="{Binding HasAction, Converter={StaticResource BoolVis}}"
                                                Command="{Binding DataContext.Maintenance.RunCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="{Binding IntentionalText}" Style="{StaticResource GhostButton}"
                                                Margin="0,0,8,0"
                                                ToolTip="Eine bewusste Entscheidung: gilt kuenftig als in Ordnung und steht ganz unten. Jederzeit rueckgaengig."
                                                Visibility="{Binding CanBeIntentional, Converter={StaticResource BoolVis}}"
                                                Command="{Binding DataContext.Maintenance.IntentionalCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="Im Web nachsehen" Style="{StaticResource GhostButton}"
                                                ToolTip="Oeffnet eine Suche im Browser. Es wird nichts im Hintergrund verschickt."
                                                Visibility="{Binding HasWebSearch, Converter={StaticResource BoolVis}}"
                                                Command="{Binding DataContext.Maintenance.SearchCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
