<UserControl x:Class="PCHelper.Views.DiagnoseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DockPanel>

        <!-- Aktionsleiste -->
        <Border DockPanel.Dock="Top" Margin="28,16,28,0" Style="{StaticResource Card}" Padding="16,14">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding Diagnose.SummaryText}" />
                        <TextBlock Text="{Binding Diagnose.ProgressText}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Bericht als PDF" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                ToolTip="Fuer Support-Anfragen - laesst sich ueberall anhaengen und oeffnen."
                                Command="{Binding Diagnose.ExportPdfCommand}" />
                        <Button Content="als HTML" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                ToolTip="Ausfuehrlicher, oeffnet im Browser."
                                Command="{Binding Diagnose.ExportHtmlCommand}" />
                        <Button Content="Kurzfassung kopieren" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                Command="{Binding Diagnose.CopyMarkdownCommand}" />
                        <Button Content="Diagnose starten" Style="{StaticResource PrimaryButton}"
                                Command="{Binding Diagnose.RunCommand}" />
                    </StackPanel>
                </Grid>

                <ProgressBar Value="{Binding Diagnose.ProgressValue, Mode=OneWay}" Maximum="100" Margin="0,12,0,0"
                             Visibility="{Binding Diagnose.IsRunning, Converter={StaticResource BoolVis}}" />

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <CheckBox Content="Nur Auffaelligkeiten anzeigen" IsChecked="{Binding Diagnose.ShowOnlyProblems}" />
                    <TextBlock Text="{Binding Diagnose.FilterHint}" Style="{StaticResource Caption}"
                               VerticalAlignment="Center" Margin="14,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Befunde -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,12,20,28">
            <ItemsControl ItemsSource="{Binding Diagnose.Findings}" MaxWidth="900" HorizontalAlignment="Left">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Farbstreifen nach Schweregrad -->
                                <Border Grid.Column="0" Background="{Binding Severity, Converter={StaticResource SeverityBrush}}"
                                        CornerRadius="10,0,0,10" />

                                <StackPanel Grid.Column="1" Margin="16,14,16,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Style="{StaticResource Chip}"
                                                Background="{Binding Severity, Converter={StaticResource SeverityBg}}"
                                                Margin="0,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SeverityText}" FontSize="10.5" FontWeight="Bold"
                                                       Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                                        </Border>

                                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold"
                                                   FontSize="14.5" VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="2" Text="{Binding Category}" Style="{StaticResource Caption}"
                                                   VerticalAlignment="Center" />
                                    </Grid>

                                    <TextBlock Text="{Binding Summary}" Margin="0,8,0,0" />

                                    <!-- Empfehlung -->
                                    <Border Background="{StaticResource Surface2}" CornerRadius="8" Padding="12,10" Margin="0,10,0,0"
                                            Visibility="{Binding Recommendation, Converter={StaticResource NotEmpty}}">
                                        <StackPanel>
                                            <TextBlock Text="Empfehlung" FontWeight="SemiBold" FontSize="12"
                                                       Foreground="{StaticResource Accent}" Margin="0,0,0,4" />
                                            <TextBlock Text="{Binding Recommendation}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Details -->
                                    <Expander Header="Technische Details"
                                              Visibility="{Binding Detail, Converter={StaticResource NotEmpty}}">
                                        <Border Background="{StaticResource Surface2}" CornerRadius="8" Padding="12,10">
                                            <TextBox Text="{Binding Detail, Mode=OneWay}" IsReadOnly="True"
                                                     BorderThickness="0" Background="Transparent" Padding="0"
                                                     FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                     TextWrapping="Wrap" MaxHeight="320"
                                                     VerticalScrollBarVisibility="Auto" />
                                        </Border>
                                    </Expander>

                                    <!-- Links -->
                                    <ItemsControl ItemsSource="{Binding Links}" Margin="0,8,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Margin="0,0,16,0">
                                                    <Hyperlink NavigateUri="{Binding Url}"
                                                               RequestNavigate="OnNavigate"
                                                               Foreground="{StaticResource Accent}">
                                                        <TextBlock Text="{Binding Label}" />
                                                    </Hyperlink>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
