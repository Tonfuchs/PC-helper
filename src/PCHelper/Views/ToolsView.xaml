<UserControl x:Class="PCHelper.Views.ToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DockPanel>
        <Border DockPanel.Dock="Top" Margin="28,16,28,0" Style="{StaticResource Card}" Padding="16,14">
            <TextBlock Text="{Binding Tools.Status}" Style="{StaticResource Muted}" />
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,12,20,28">
            <ItemsControl ItemsSource="{Binding Tools.Groups}" MaxWidth="900" HorizontalAlignment="Left">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource H2}" Margin="0,10,0,8" />

                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}" Padding="16,13">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}"
                                                               Margin="0,3,0,0" />
                                                </StackPanel>

                                                <Button Grid.Column="1" Content="{Binding ButtonText}"
                                                        Style="{StaticResource SecondaryButton}" MinWidth="120"
                                                        VerticalAlignment="Center"
                                                        Command="{Binding Command}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
