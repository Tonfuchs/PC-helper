<Window x:Class="PCHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:PCHelper.Views"
        Title="PC Helper"
        Width="1180" Height="780"
        MinWidth="940" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= Navigation ================= -->
        <Border Grid.Column="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">

                <StackPanel DockPanel.Dock="Top" Margin="20,22,20,18">
                    <TextBlock Text="PC Helper" Style="{StaticResource H1}" FontSize="20" />
                    <TextBlock Text="Diagnose fuer Windows-Probleme aller Art" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Statusleiste unten -->
                <Border DockPanel.Dock="Bottom" Margin="16,10,16,16" Padding="12,10"
                        Background="{StaticResource Surface2}" CornerRadius="8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource Dim}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Monitoring.IsRunning}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource Ok}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="Ueberwachung" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="{Binding Monitoring.LastSampleText}" Style="{StaticResource Caption}" Margin="16,2,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock DockPanel.Dock="Bottom" Text="{Binding VersionText}"
                           Style="{StaticResource Caption}" Margin="20,0,20,4" />

                <StackPanel Margin="0,4,0,0">
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE80F;" Content="Uebersicht"
                                 GroupName="nav" IsChecked="{Binding IsDashboard, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="dashboard" />
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE897;" Content="Problem melden"
                                 GroupName="nav" IsChecked="{Binding IsSymptom, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="symptom" />
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE9D9;" Content="Diagnose"
                                 GroupName="nav" IsChecked="{Binding IsDiagnose, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="diagnose" />
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE9D2;" Content="Dauerueberwachung"
                                 GroupName="nav" IsChecked="{Binding IsMonitor, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="monitor" />
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE90F;" Content="Reparaturen"
                                 GroupName="nav" IsChecked="{Binding IsFixes, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="fixes" />
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE8FD;" Content="Wartung"
                                 GroupName="nav" IsChecked="{Binding IsMaintenance, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="maintenance" />
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE912;" Content="Werkzeuge"
                                 GroupName="nav" IsChecked="{Binding IsTools, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="tools" />
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE713;" Content="Einstellungen"
                                 GroupName="nav" IsChecked="{Binding IsSettings, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="settings" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= Inhalt ================= -->
        <DockPanel Grid.Column="1">

            <!-- Kopfzeile -->
            <Border DockPanel.Dock="Top" Padding="28,20,28,16" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                <StackPanel>
                    <TextBlock Text="{Binding PageTitle}" Style="{StaticResource H1}" />
                    <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <!-- Update-Hinweis -->
            <Border DockPanel.Dock="Top" Margin="28,16,28,0" Padding="16,14"
                    Background="{StaticResource AccentSoft}" CornerRadius="10"
                    Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Ein Update ist verfuegbar" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="{Binding UpdateHeadline}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                   Visibility="{Binding UpdateStatus, Converter={StaticResource NotEmpty}}" />
                        <ProgressBar Value="{Binding DownloadProgress, Mode=OneWay}" Maximum="100" Margin="0,8,0,0"
                                     Visibility="{Binding IsDownloading, Converter={StaticResource BoolVis}}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Was ist neu?" Style="{StaticResource GhostButton}"
                                Command="{Binding OpenReleaseNotesCommand}" Margin="0,0,8,0" />
                        <Button Content="Spaeter" Style="{StaticResource SecondaryButton}"
                                Command="{Binding DismissUpdateCommand}" Margin="0,0,8,0" />
                        <Button Content="Jetzt aktualisieren" Style="{StaticResource PrimaryButton}"
                                Command="{Binding InstallUpdateCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Seiten -->
            <Grid>
                <v:DashboardView Visibility="{Binding IsDashboard, Converter={StaticResource BoolVis}}" />
                <v:SymptomView   Visibility="{Binding IsSymptom,   Converter={StaticResource BoolVis}}" />
                <v:DiagnoseView  Visibility="{Binding IsDiagnose,  Converter={StaticResource BoolVis}}" />
                <v:MonitorView   Visibility="{Binding IsMonitor,   Converter={StaticResource BoolVis}}" />
                <v:FixesView     Visibility="{Binding IsFixes,     Converter={StaticResource BoolVis}}" />
                <v:MaintenanceView Visibility="{Binding IsMaintenance, Converter={StaticResource BoolVis}}" />
                <v:ToolsView     Visibility="{Binding IsTools,     Converter={StaticResource BoolVis}}" />
                <v:SettingsView  Visibility="{Binding IsSettings,  Converter={StaticResource BoolVis}}" />
            </Grid>
        </DockPanel>
    </Grid>
</Window>
