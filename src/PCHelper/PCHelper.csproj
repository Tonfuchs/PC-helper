<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>PCHelper</RootNamespace>
    <AssemblyName>PCHelper</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- WFAC010: Der WinForms-Analyzer beanstandet die DPI-Angaben im Manifest.
         Fuer eine WPF-Anwendung gehoeren sie aber genau dorthin. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>

    <!-- Wird vom Release-Workflow aus dem Git-Tag ueberschrieben (-p:Version=x.y.z). -->
    <Version>1.0.0</Version>
    <Product>PC Helper</Product>
    <Company>PC Helper Contributors</Company>
    <Description>Diagnose- und Ueberwachungswerkzeug fuer sporadische Windows-Probleme (Schwarzbild, Abstuerze, Instabilitaet).</Description>
    <Copyright>MIT</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms wird nur fuer das Symbol im Infobereich gebraucht. Die impliziten
         globalen using-Direktiven wuerden sonst mit WPF-Typen kollidieren
         (UserControl, Brush, Application ...). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Einzige Quelle der Wahrheit: dieselbe Datei wird eingebettet UND im Repo
         gepflegt, damit sie ohne App-Update per GitHub nachgeladen werden kann. -->
    <EmbeddedResource Include="..\..\knowledge\known-issues.json" LogicalName="PCHelper.known-issues.json" />
  </ItemGroup>

</Project>
