<Application x:Class="PCHelper.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PCHelper.Controls"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <c:SeverityToBrushConverter x:Key="SeverityBrush" />
            <c:SeverityToBrushConverter x:Key="SeverityBg" Background="True" />
            <c:NotEmptyToVisibilityConverter x:Key="NotEmpty" />
            <c:NotNullToVisibilityConverter x:Key="NotNull" />
            <c:InverseBoolToVisibilityConverter x:Key="InverseBoolVis" />
            <BooleanToVisibilityConverter x:Key="BoolVis" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
